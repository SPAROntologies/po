<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#contains">
    <rdfs:domain rdf:resource="http://www.essepuntato.it/2008/12/pattern#Structured"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label xml:lang="en">contains</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/po"/>
    <vann:example>
        :my-container 
                po:contains :my-block .
        </vann:example>
    <owl:inverseOf rdf:resource="http://www.essepuntato.it/2008/12/pattern#isContainedBy"/>
    <rdfs:comment xml:lang="en">The relation between a structured element containing another generic element, and that other element.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
</rdf:RDF>
