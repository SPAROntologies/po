<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#canContainHomonymousElements">
    <rdfs:domain rdf:resource="http://www.essepuntato.it/2008/12/pattern#Structured"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">can contain homonymous elements</rdfs:label>
    <rdfs:comment xml:lang="en">An indication whether a hierarchical-based entity contains al least two entities that share the same name or not.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:isDefinedBy rdf:resource="http://www.essepuntato.it/2008/12/pattern#"/>
    <vann:example>
        :my-list 
                po:canContainHomonymousElements true .
        </vann:example>
  </rdf:Description>
</rdf:RDF>
