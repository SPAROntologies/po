    <rdfs:isDefinedBy rdf:resource="http://www.essepuntato.it/2008/12/pattern#"/>
    <rdfs:comment xml:lang="en">An element that organises the document content as a sequence of nestable elements and text nodes, and that can contain other elements compliant with the same pattern.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inline element</rdfs:label>
  </rdf:Description>
