    <vann:example>
        :my-footnote a po:Popup ;
                po:isContainedBy :my-paragraph ;
                po:contains :my-footnote-block .
        </vann:example>
    <rdfs:comment xml:lang="en">A bucket element that is only present within block and inline elements.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.essepuntato.it/2008/12/pattern#"/>
    <rdfs:label xml:lang="en">popup element</rdfs:label>
