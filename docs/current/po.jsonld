  {
    "@id": "http://www.essepuntato.it/2008/12/pattern#isContainedByAsHeader",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-header-block \n                po:isContainedByAsHeader :my-section .\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between an element, contained by another structured element as part of its header, and that other element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#"
