    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "http://www.essepuntato.it/2008/12/pattern#Block"
          },
          {
            "@id": "http://www.essepuntato.it/2008/12/pattern#Inline"
          }
        ]
      }
    ]
  },
  {
    "@id": "http://www.essepuntato.it/2008/12/pattern#Marker",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-break-tag a po:Marker ;\n                po:hasName \"br\" .\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An element that can contain neither text nodes nor elements."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "marker element"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#NonStructured"
      },
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#NonTextual"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ]
  },
  {
    "@id": "http://www.essepuntato.it/2008/12/pattern#Container",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-body a po:Container ;\n                po:contains :section-1, :section-2 .\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An element concerning the structural organization of a document."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "container element"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:nbb8eeaf6fa2b4101bbf5d8c485edaab7b72"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#Popup"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:nbb8eeaf6fa2b4101bbf5d8c485edaab7b78"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "\nElements following this pattern contain no textual content and contain only elements compliant with the patterns: `po:Meta`, `po:Field`, `po:Block` and any subtype of `po:Container`. \n\nIt is disjointed with the pattern `po:Popup`, although they share the same content model.\n    "
      }
    ]
  },
  {
    "@id": "_:nbb8eeaf6fa2b4101bbf5d8c485edaab7b72",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#allValuesFrom": [
      {
        "@id": "_:nbb8eeaf6fa2b4101bbf5d8c485edaab7b73"
      }
    ],
