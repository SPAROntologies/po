    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-block \n                po:isContainedBy :my-container .\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An element that is contained by another structured element."
