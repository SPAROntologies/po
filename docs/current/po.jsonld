  {
    "@id": "http://www.essepuntato.it/2008/12/pattern#HeadedContainer",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-section a po:HeadedContainer ;\n                po:containsAsHeader :my-title ;\n                po:contains :my-para .\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A container element whose content model needs to begin with one or more block elements (the heading)."
      }
    ],
