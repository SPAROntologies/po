  {
    "@id": "http://www.essepuntato.it/2008/12/pattern#Block",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-paragraph a po:Block ;\n                po:isContainedBy :my-section ;\n                po:contains :my-span .\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An element that organises the document content as a sequence of nestable elements and text nodes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "block element"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n27f50dd15b7c417789d400bde3c61873b85"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#Inline"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:n27f50dd15b7c417789d400bde3c61873b91"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "\nIn particular, elements following this pattern can contain text and other elements compliant with the patterns `po:Inline`, `po:Atom`, `po:Milestones` and `po:Popup`. \n\nFurthermore, it is a requirement that block elements are contained only by container and popup elements.\n    "
      }
    ]
  },
