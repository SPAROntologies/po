  {
    "@id": "http://www.essepuntato.it/2008/12/pattern#Milestone",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-page-break a po:Milestone ;\n                po:isContainedBy :my-paragraph .\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\nAn elements that contains neither other elements nor textual content.\n"
      }
