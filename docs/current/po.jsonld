    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "_:n2310ddb3cbc14762a79ca19ea8edb924b39"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "\nSimilarly to `po:Inline`, elements following the `po:Milestone` pattern can only be contained within block or inline elements (and consequently they also cannot be used as root elements of documents).\n\nThe distinctive characteristic of the pattern `po:Milestone` is the location it assumes within the document.\n    "
      }
    ]
