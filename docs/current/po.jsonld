    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n        :my-element a po:Pattern .\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\nAn atomic component of a document that is able to capture a recurrent and well knwon structure of a document.\n"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.essepuntato.it/2008/12/pattern#"
      }
