@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix po: <http://www.essepuntato.it/2008/12/pattern#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

po:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    vann:example """
        :my-container 
                po:contains :my-block .
        """ ;
    rdfs:comment "The relation between a structured element containing another generic element, and that other element."@en ;
    rdfs:domain po:Structured ;
    rdfs:isDefinedBy po: ;
    owl:inverseOf po:isContainedBy ;
    vs:term_status reg:statusStable .

