<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#containsAsHeader">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.essepuntato.it/2008/12/pattern#"/>
    <rdfs:comment xml:lang="en">The relation between a structured element, containing another generic element as part of its header, and that other element.</rdfs:comment>
    <vann:example>
        :my-section 
                po:containsAsHeader :my-header-block .
        </vann:example>
    <rdfs:label xml:lang="en">contains as header</rdfs:label>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:subPropertyOf rdf:resource="http://www.essepuntato.it/2008/12/pattern#contains"/>
    <owl:inverseOf rdf:resource="http://www.essepuntato.it/2008/12/pattern#isContainedByAsHeader"/>
  </rdf:Description>
</rdf:RDF>
