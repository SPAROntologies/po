  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b29">
    <rdf:first rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b26"/>
    <rdf:rest rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b30"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b27">
    <owl:onProperty rdf:resource="http://www.essepuntato.it/2008/12/pattern#canContainHomonymousElements"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#Record">
    <owl:equivalentClass rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b25"/>
    <rdfs:label xml:lang="en">record element</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.essepuntato.it/2008/12/pattern#"/>
    <rdfs:comment xml:lang="en">A container element that can only contain heterogeneous and non repeatable elements.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <vann:example>
        :my-author-record a po:Record ;
                po:canContainHeteronymousElements true ;
                po:canContainHomonymousElements false .
        </vann:example>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b28">
    <rdf:first rdf:resource="http://www.essepuntato.it/2008/12/pattern#Container"/>
