>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b83">
    <rdf:rest rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b84"/>
    <rdf:first rdf:resource="http://www.essepuntato.it/2008/12/pattern#Bucket"/>
