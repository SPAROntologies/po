   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b7">
    <rdf:first rdf:resource="http://www.essepuntato.it/2008/12/pattern#Block"/>
    <rdf:rest rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b14"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#Atom">
    <rdfs:comment xml:lang="en">Literal text that is part of the document body.</rdfs:comment>
    <skos:note xml:lang="en">
Similarly to `po:Inline`, elements following the 'atom' pattern can only be contained within block or inline elements (and consequently they also cannot be used as root elements of documents). 
It can contain textual content and no other elements.
    </skos:note>
    <rdfs:isDefinedBy rdf:resource="http://www.essepuntato.it/2008/12/pattern#"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label xml:lang="en">atom element</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b9"/>
    <rdfs:subClassOf rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b5"/>
    <owl:disjointWith rdf:resource="http://www.essepuntato.it/2008/12/pattern#Field"/>
    <vann:example>
        :my-atom a po:Atom ;
                po:isContainedBy :my-paragraph .
        </vann:example>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b6"/>
    <owl:onProperty rdf:resource="http://www.essepuntato.it/2008/12/pattern#isContainedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b14">
    <rdf:first rdf:resource="http://www.essepuntato.it/2008/12/pattern#Flat"/>
    <rdf:rest rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b15"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b8">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://www.essepuntato.it/2008/12/pattern#Inline"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b10">
    <owl:onProperty rdf:resource="http://www.essepuntato.it/2008/12/pattern#isContainedBy"/>
