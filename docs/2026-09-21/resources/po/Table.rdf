  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#Table">
    <vann:example>
        :my-list a po:Table ;
                po:canContainHeteronymousElements false ;
                po:canContainHomonymousElements true .
        </vann:example>
    <rdfs:comment xml:lang="en">A container element that must contain only homogeneous elements (but they can be repeated).</rdfs:comment>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:isDefinedBy rdf:resource="http://www.essepuntato.it/2008/12/pattern#"/>
    <owl:equivalentClass rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b49"/>
    <rdfs:label xml:lang="en">table element</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nbb8eeaf6fa2b4101bbf5d8c485edaab7b50">
    <owl:onProperty rdf:resource="http://www.essepuntato.it/2008/12/pattern#canContainHeteronymousElements"/>
