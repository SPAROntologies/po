<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://www.essepuntato.it/2008/12/pattern#Flat">
    <owl:disjointWith rdf:resource="http://www.essepuntato.it/2008/12/pattern#Mixed"/>
    <rdfs:isDefinedBy rdf:resource="http://www.essepuntato.it/2008/12/pattern#"/>
    <rdfs:label xml:lang="en">flat element</rdfs:label>
    <rdfs:comment xml:lang="en">An element that can contain text nodes but no elements.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
        :my-flat a po:Flat ;
                po:hasName "text" .
        </vann:example>
    <rdfs:subClassOf rdf:resource="http://www.essepuntato.it/2008/12/pattern#Textual"/>
    <rdfs:subClassOf rdf:resource="http://www.essepuntato.it/2008/12/pattern#NonStructured"/>
  </rdf:Description>
</rdf:RDF>
